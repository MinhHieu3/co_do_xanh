# Keep bot credentials on the server (Vercel environment variables or local .env.local).
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
# Optional recipient for booking alerts. Contact messages still use ZALO_CHAT_ID.
ZALO_BOOKING_CHAT_ID=
# Required only while pairing a private chat through the production webhook.
ZALO_WEBHOOK_SECRET=
ZALO_PAIRING_CODE=
# Optional SHA-256 digest of the group pairing code.
ZALO_GROUP_PAIRING_HASH=
# Optional: override the existing Cloudflare API that stores website orders.
ORDER_API_URL=https://xe-co-do-xanh-be.hieubyipro.workers.dev/api
VITE_WHATSAPP_NUMBER=your_whatsapp_number_here
VITE_ZALO_NUMBER=your_zalo_number_here
VITE_PHONE_NUMBER=your_phone_number_here
VITE_MESSENGER_URL=your_messenger_url_here

# true = show prices, false = show "Liên hệ" instead
VITE_SHOW_PRICE=true
