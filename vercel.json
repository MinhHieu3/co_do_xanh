{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index-en", "destination": "/index-en.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:page(booking|pricing|contact|news|faq|policy|privacy)", "destination": "/:page/index.html" },
    { "source": "/news/:slug", "destination": "/news/:slug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/ebike/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
